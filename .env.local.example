# Demo target. Controls whether the eval primitives are faked (local) or real (cloud).
# - local (default): faked/seeded scores, sessions, experiments. Offline-safe, dev-server
#   only. Behaviorally unchanged from the booth build.
# - cloud: emit REAL Inngest eval primitives (run-level step.score, the createScorer/defer
#   deferred outcome scorer, group.experiment) and register against Inngest Cloud. Requires
#   INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY below and INNGEST_DEV unset/false. isDev derives
#   from DEMO_TARGET in src/inngest/client.ts, so do NOT also set INNGEST_DEV in cloud mode.
# Note: sessions stay FAKED in both modes this pass (the sessions primitive is not in the
# pinned SDK; see README "Cloud mode" and CONTRACT.md §0).
DEMO_TARGET=local

# Local Inngest dev server. This is the default path for `npm run dev`.
INNGEST_DEV=1
NEXT_PUBLIC_INNGEST_DASHBOARD_URL=http://localhost:8288
NEXT_PUBLIC_INNGEST_RUNS_URL=http://localhost:8288

# Production / Inngest Cloud:
# - Set these in Vercel for production.
# - Leave INNGEST_DEV unset in production.
# - For a localhost Cloud smoke test, export the keys and run `npm run dev:cloud`.
# - For real eval primitives in Cloud, also set DEMO_TARGET=cloud (see top of file) and
#   seed the corpus with `npm run demo:seed-cloud`.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_ENCRYPTION_KEY=
# INNGEST_ENV=
# INNGEST_API_KEY=
# INNGEST_API_BASE_URL=https://api.inngest.com
# INNGEST_INSIGHTS_SCORE_QUERY=
# DEMO_SEED_TOKEN=
# NEXT_PUBLIC_INNGEST_DASHBOARD_URL=https://app.inngest.com
# NEXT_PUBLIC_INNGEST_RUNS_URL=https://app.inngest.com
