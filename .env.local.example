# Local Inngest dev server. This is the default path for `npm run dev`.
INNGEST_DEV=1
NEXT_PUBLIC_INNGEST_DASHBOARD_URL=http://localhost:8288
NEXT_PUBLIC_INNGEST_RUNS_URL=http://localhost:8288

# Production / Inngest Cloud:
# - Set these in Vercel for production.
# - Leave INNGEST_DEV unset in production.
# - For a localhost Cloud smoke test, export the keys and run `npm run dev:cloud`.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_ENCRYPTION_KEY=
# INNGEST_ENV=
# INNGEST_API_KEY=
# INNGEST_API_BASE_URL=https://api.inngest.com
# INNGEST_INSIGHTS_SCORE_QUERY=
# DEMO_SEED_TOKEN=
# NEXT_PUBLIC_INNGEST_DASHBOARD_URL=https://app.inngest.com
# NEXT_PUBLIC_INNGEST_RUNS_URL=https://app.inngest.com
